<script>
const DATA = __DATA_JSON__;
const META = __META_JSON__;

const DAY = 86400000;
const iso = d => d.toISOString().slice(0, 10);
const parse = s => { const [y, m, d] = s.split("-").map(Number); return new Date(Date.UTC(y, m - 1, d)); };
const MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const WEEKDAYS = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
const fmtDate = d => `${WEEKDAYS[d.getUTCDay()]}, ${MONTHS[d.getUTCMonth()]} ${d.getUTCDate()}, ${d.getUTCFullYear()}`;
const n = x => x.toLocaleString("en-US");

const allDates = Object.keys(DATA).sort();
const FIRST = parse(allDates[0]);
const LAST = parse(allDates[allDates.length - 1]);
const TODAY = parse(META.today);
const YEARS = [];
for (let y = FIRST.getUTCFullYear(); y <= LAST.getUTCFullYear(); y++) {
  if (allDates.some(d => d.startsWith(String(y)))) YEARS.push(String(y));
}
YEARS.reverse();

// "Last 12 months" is anchored to today, the way a contribution graph reads.
const WINDOWS = [
  { id: "12m", label: "Last 12 months", start: new Date(+TODAY - 364 * DAY), end: TODAY },
  ...YEARS.map(y => ({
    id: y, label: y,
    start: new Date(Date.UTC(+y, 0, 1)),
    end: new Date(Math.min(Date.UTC(+y, 11, 31), +TODAY)),
  })),
];

// A dormant repo would open on an empty grid; land on its most recent active year instead.
const commitsIn = w => allDates.reduce((s, k) => {
  const t = +parse(k);
  return s + (t >= +w.start && t <= +w.end ? DATA[k] : 0);
}, 0);
let current = commitsIn(WINDOWS[0]) > 0 ? WINDOWS[0] : (WINDOWS[1] || WINDOWS[0]);

/** Quartile thresholds over the non-zero days in range, deduped; falls back to an
 *  even split of the max when the window has too few distinct values. */
function buckets(counts) {
  const nz = counts.filter(c => c > 0).sort((a, b) => a - b);
  if (!nz.length) return [1, 2, 3, 4];
  const q = p => nz[Math.min(nz.length - 1, Math.floor(nz.length * p))];
  let t = [q(0.25), q(0.5), q(0.75)];
  const max = nz[nz.length - 1];
  for (let i = 1; i < 3; i++) if (t[i] <= t[i - 1]) t[i] = t[i - 1] + 1;
  if (t[2] >= max) t = [1, Math.max(2, Math.ceil(max / 3)), Math.max(3, Math.ceil((2 * max) / 3))];
  return t;
}
const levelOf = (c, t) => (c === 0 ? 0 : c <= t[0] ? 1 : c <= t[1] ? 2 : c <= t[2] ? 3 : 4);

function render() {
  const { start, end } = current;
  const gridStart = new Date(+start - start.getUTCDay() * DAY);
  const gridEnd = new Date(+end + (6 - end.getUTCDay()) * DAY);

  const days = [];
  for (let t = +gridStart; t <= +gridEnd; t += DAY) {
    const d = new Date(t), key = iso(d);
    const within = t >= +start && t <= +end;
    days.push({ d, key, count: within ? (DATA[key] || 0) : null, inRange: within });
  }
  const inRange = days.filter(x => x.inRange);
  const thresholds = buckets(inRange.map(x => x.count));
  const weeks = Math.ceil(days.length / 7);

  const grid = document.getElementById("grid");
  grid.replaceChildren();
  for (const x of days) {
    const cell = document.createElement("button");
    cell.type = "button";
    cell.className = "cell";
    if (!x.inRange) {
      cell.dataset.empty = "true";
      cell.tabIndex = -1;
      cell.setAttribute("aria-hidden", "true");
    } else {
      cell.dataset.level = levelOf(x.count, thresholds);
      cell.dataset.label =
        (x.count === 0 ? "No commits" : `${n(x.count)} commit${x.count === 1 ? "" : "s"}`) +
        ` on ${fmtDate(x.d)}`;
      cell.setAttribute("aria-label", cell.dataset.label);
    }
    grid.appendChild(cell);
  }

  const months = document.getElementById("months");
  months.replaceChildren();
  months.style.gridTemplateColumns = `repeat(${weeks}, 12px)`;
  let prevMonth = -1, lastLabelCol = -99;
  for (let w = 0; w < weeks; w++) {
    // Label from the column's first IN-RANGE day. A year window's leading column
    // is mostly the previous December, and letting it claim the label crowds out
    // January entirely.
    const firstIn = days.slice(w * 7, w * 7 + 7).find(x => x.inRange);
    if (!firstIn) continue;
    const m = firstIn.d.getUTCMonth();
    if (m !== prevMonth && w - lastLabelCol >= 3 && w < weeks - 2) {
      const span = document.createElement("span");
      span.textContent = MONTHS[m] + (current.id === "12m" && m === 0 ? " " + firstIn.d.getUTCFullYear() : "");
      span.style.gridColumnStart = w + 1;
      months.appendChild(span);
      lastLabelCol = w;
    }
    prevMonth = m;
  }

  const total = inRange.reduce((s, x) => s + x.count, 0);
  const active = inRange.filter(x => x.count > 0).length;
  document.getElementById("hero").textContent =
    `${n(total)} commit${total === 1 ? "" : "s"} ${current.id === "12m" ? "in the last year" : "in " + current.id}`;
  document.getElementById("heroSub").textContent =
    `${fmtDate(start)} – ${fmtDate(end)} · ${n(active)} active day${active === 1 ? "" : "s"} of ${n(inRange.length)} (${Math.round((active / inRange.length) * 100)}%)`;

  // collapse single-value bands: "1-1" reads as noise, "1" reads as a value
  const band = (lo, hi) => (lo === hi ? `${lo}` : `${lo}–${hi}`);
  document.getElementById("legendScale").textContent =
    [band(1, thresholds[0]), band(thresholds[0] + 1, thresholds[1]),
     band(thresholds[1] + 1, thresholds[2]), `${thresholds[2] + 1}+`].join(" · ");

  renderTiles(inRange, total, active);
  renderTable(inRange, total);
}

function renderTiles(inRange, total, active) {
  let best = { count: 0 };
  for (const x of inRange) if (x.count > best.count) best = x;

  let streak = 0, bestStreak = 0, streakEnd = null, bestEnd = null;
  for (const x of inRange) {
    if (x.count > 0) { streak++; streakEnd = x.d; if (streak > bestStreak) { bestStreak = streak; bestEnd = streakEnd; } }
    else streak = 0;
  }
  const perActive = active ? (total / active).toFixed(1) : "0";

  const tiles = [
    { label: "Commits", value: n(total), note: `${perActive} per active day` },
    { label: "Active days", value: n(active), note: `${Math.round((active / inRange.length) * 100)}% of the window` },
    { label: "Busiest day", value: best.count ? n(best.count) : "—", note: best.count ? fmtDate(best.d) : "no commits" },
    { label: "Longest streak", value: bestStreak ? `${bestStreak} day${bestStreak === 1 ? "" : "s"}` : "—", note: bestEnd ? `ending ${MONTHS[bestEnd.getUTCMonth()]} ${bestEnd.getUTCDate()}, ${bestEnd.getUTCFullYear()}` : "" },
  ];
  document.getElementById("tiles").replaceChildren(...tiles.map(t => {
    const el = document.createElement("div");
    el.className = "tile";
    el.innerHTML = `<div class="label"></div><div class="value"></div><div class="note"></div>`;
    el.querySelector(".label").textContent = t.label;
    el.querySelector(".value").textContent = t.value;
    el.querySelector(".note").textContent = t.note;
    return el;
  }));
}

// table view: the WCAG-clean twin, every value reachable without colour
function renderTable(inRange, total) {
  const byMonth = new Map();
  for (const x of inRange) {
    if (!x.count) continue;
    const k = x.key.slice(0, 7);
    const row = byMonth.get(k) || { commits: 0, days: 0, best: 0, bestDate: null };
    row.commits += x.count; row.days++;
    if (x.count > row.best) { row.best = x.count; row.bestDate = x.d; }
    byMonth.set(k, row);
  }
  const body = document.getElementById("tableBody");
  body.replaceChildren(...[...byMonth.entries()].map(([k, r]) => {
    const [y, m] = k.split("-");
    const tr = document.createElement("tr");
    tr.innerHTML = `<th scope="row"></th><td></td><td></td><td></td>`;
    const c = tr.children;
    c[0].textContent = `${MONTHS[+m - 1]} ${y}`;
    c[1].textContent = n(r.commits);
    c[2].textContent = n(r.days);
    c[3].textContent = `${n(r.best)} on ${MONTHS[r.bestDate.getUTCMonth()]} ${r.bestDate.getUTCDate()}`;
    return tr;
  }));
  const foot = document.getElementById("tableFoot");
  foot.innerHTML = `<tr><td>Total</td><td></td><td></td><td></td></tr>`;
  foot.querySelector("td:nth-child(2)").textContent = n(total);
  foot.querySelector("td:nth-child(3)").textContent = n([...byMonth.values()].reduce((s, r) => s + r.days, 0));
  document.getElementById("tableCaption").textContent =
    `Commits by month — ${current.label}. Months with no commits are omitted.`;
}

// tooltip: hover and keyboard focus show the same thing
const tip = document.getElementById("tip");
const card = document.getElementById("graphCard");
function showTip(cell) {
  if (!cell || !cell.dataset.label) return hideTip();
  tip.textContent = cell.dataset.label;
  tip.dataset.show = "true";
  const c = cell.getBoundingClientRect(), p = card.getBoundingClientRect();
  tip.style.left = `${c.left - p.left + c.width / 2}px`;
  tip.style.top = `${c.top - p.top - 6}px`;
}
const hideTip = () => { tip.dataset.show = "false"; };
const gridEl = document.getElementById("grid");
gridEl.addEventListener("pointerover", e => showTip(e.target.closest(".cell")));
gridEl.addEventListener("pointerleave", hideTip);
gridEl.addEventListener("focusin", e => showTip(e.target.closest(".cell")));
gridEl.addEventListener("focusout", hideTip);

const seg = document.getElementById("windowSeg");
seg.replaceChildren(...WINDOWS.map(w => {
  const b = document.createElement("button");
  b.type = "button";
  b.textContent = w.label;
  b.setAttribute("aria-pressed", String(w === current));
  b.addEventListener("click", () => {
    current = w;
    for (const other of seg.children) other.setAttribute("aria-pressed", String(other === b));
    hideTip();
    render();
  });
  return b;
}));

const btnGraph = document.getElementById("btnGraph"), btnTable = document.getElementById("btnTable");
function setView(graph) {
  document.getElementById("graphCard").hidden = !graph;
  document.getElementById("tableCard").hidden = graph;
  btnGraph.setAttribute("aria-pressed", String(graph));
  btnTable.setAttribute("aria-pressed", String(!graph));
}
btnGraph.addEventListener("click", () => setView(true));
btnTable.addEventListener("click", () => setView(false));

document.getElementById("eyebrow").textContent = META.scope;
document.getElementById("footnote").textContent =
  `${n(allDates.reduce((s, k) => s + DATA[k], 0))} commits total across ${n(allDates.length)} distinct days, ` +
  `${allDates[0]} to ${allDates[allDates.length - 1]}. Counted by ${META.dateKind} date in the recorded local timezone. ` +
  `Colour buckets are quartiles of the non-zero days within the selected window, so shades are comparable inside a ` +
  `window but not across windows — the tooltip and table carry the real numbers. Generated by ${META.generator}.`;

render();
</script>
</body>
</html>
