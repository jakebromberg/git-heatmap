#!/usr/bin/env python3
"""Render a GitHub-style commit-frequency heatmap for any local git repository.

Reads commit dates straight out of `git log` and writes a single self-contained
HTML file -- no network, no dependencies, no build step. Because the executable
is named `git-heatmap`, git exposes it as a subcommand: `git heatmap`.

    git heatmap                          # current repo, opens in your browser
    git heatmap ~/src/foo -o foo.html    # another repo, explicit output
    git heatmap --author 'Jake' --all    # one author, across every ref
    git heatmap --json                   # per-day counts on stdout, no HTML

Exit codes: 0 ok, 1 usage/runtime error, 2 repo has no matching commits.
"""

from __future__ import annotations

import argparse
import json
import logging
import os
import subprocess
import sys
import tempfile
import webbrowser
from collections import Counter
from datetime import date
from pathlib import Path

__version__ = "1.0.0"

log = logging.getLogger("git-heatmap")


class GitHeatmapError(RuntimeError):
    """Anything that should exit non-zero with a clean message, not a traceback."""


# ---------------------------------------------------------------- git plumbing


def run_git(repo: Path, *args: str) -> str:
    """Run a git command in `repo` and return stdout, raising on failure."""
    cmd = ["git", "-C", str(repo), *args]
    log.debug("running: %s", " ".join(cmd))
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, check=False)
    except FileNotFoundError as exc:  # git itself missing
        raise GitHeatmapError("`git` was not found on PATH") from exc
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip().splitlines()
        raise GitHeatmapError(
            f"git {' '.join(args[:2])} failed: {detail[0] if detail else 'unknown error'}"
        )
    return proc.stdout


def resolve_repo(path: Path) -> Path:
    """Return the work-tree root containing `path`."""
    if not path.exists():
        raise GitHeatmapError(f"no such path: {path}")
    try:
        top = run_git(path, "rev-parse", "--show-toplevel").strip()
    except GitHeatmapError as exc:
        raise GitHeatmapError(f"{path} is not inside a git repository") from exc
    return Path(top) if top else path


def repo_label(repo: Path) -> str:
    """`owner/name` when a remote makes that knowable, else the directory name."""
    try:
        url = run_git(repo, "remote", "get-url", "origin").strip()
    except GitHeatmapError:
        return repo.name
    if not url:
        return repo.name
    url = url.removesuffix(".git")
    if url.startswith("git@") and ":" in url:  # git@github.com:owner/name
        url = url.split(":", 1)[1]
    parts = [p for p in url.replace("//", "/").split("/") if p]
    return "/".join(parts[-2:]) if len(parts) >= 2 else repo.name


def collect_counts(repo: Path, args: argparse.Namespace) -> Counter[str]:
    """Per-day commit counts as {'YYYY-MM-DD': n}, honoring the CLI filters."""
    # %ad/%cd with --date=short yields the date in the recorded local offset,
    # which is what a contribution graph should show: the day work happened.
    fmt = "%ad" if args.date == "author" else "%cd"
    cmd = ["log", "--date=short", f"--pretty=format:{fmt}"]
    if args.all_refs:
        cmd.append("--all")
    else:
        cmd.append(args.branch)
    if args.no_merges:
        cmd.append("--no-merges")
    for pattern in args.author or []:
        cmd.append(f"--author={pattern}")
    if args.since:
        cmd.append(f"--since={args.since}")
    if args.until:
        cmd.append(f"--until={args.until}")
    if args.path:
        cmd.append("--")
        cmd.extend(args.path)

    out = run_git(repo, *cmd)
    return Counter(line.strip() for line in out.splitlines() if line.strip())


def author_summary(repo: Path, args: argparse.Namespace) -> str:
    """A short human description of whose commits are being shown."""
    if args.author:
        return " / ".join(args.author)
    fmt = "%aN" if args.date == "author" else "%cN"  # %aN respects .mailmap
    cmd = ["log", "--pretty=format:" + fmt]
    cmd.append("--all" if args.all_refs else args.branch)
    if args.no_merges:
        cmd.append("--no-merges")
    try:
        names = {n.strip() for n in run_git(repo, *cmd).splitlines() if n.strip()}
    except GitHeatmapError:
        return "all authors"
    if len(names) == 1:
        return next(iter(names))
    return f"all authors ({len(names)})"


# ------------------------------------------------------------------- rendering


def build_meta(repo: Path, args: argparse.Namespace, counts: Counter[str]) -> dict:
    scope_bits = [f"{args.date} dates"]
    scope_bits.insert(0, author_summary(repo, args))
    if args.all_refs:
        scope_bits.append("all refs")
    elif args.branch != "HEAD":
        scope_bits.append(args.branch)
    if args.no_merges:
        scope_bits.append("no merges")
    if args.path:
        scope_bits.append("paths: " + " ".join(args.path))
    if args.since:
        scope_bits.append(f"since {args.since}")
    if args.until:
        scope_bits.append(f"until {args.until}")

    label = args.label or repo_label(repo)
    return {
        "repo": label,
        "scope": " — ".join([label, ", ".join(scope_bits)]),
        "title": args.title or f"{label} — commit frequency",
        "today": date.today().isoformat(),
        "dateKind": args.date,
        "generator": f"git-heatmap {__version__}",
    }


def render_html(counts: Counter[str], meta: dict) -> str:
    data_json = json.dumps(dict(sorted(counts.items())), separators=(",", ":"))
    return (
        TEMPLATE
        .replace("__DATA_JSON__", data_json)
        .replace("__META_JSON__", json.dumps(meta))
        .replace("__TITLE__", escape_html(meta["title"]))
    )


def escape_html(text: str) -> str:
    return (
        text.replace("&", "&amp;").replace("<", "&lt;")
        .replace(">", "&gt;").replace('"', "&quot;")
    )


# ------------------------------------------------------------------------- cli


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="git-heatmap",
        description="Render a GitHub-style commit-frequency heatmap for a git repo.",
        epilog=(
            "Installed on PATH as `git-heatmap`, it also runs as `git heatmap`.\n"
            "Note: git rewrites `git heatmap --help` into a man-page lookup, so use\n"
            "`git heatmap -h` or `git-heatmap --help` to see this text."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("repo", nargs="?", default=".", type=Path,
                   help="repository path (default: current directory)")
    p.add_argument("-o", "--output", type=Path,
                   help="write HTML here (default: a temp file)")
    p.add_argument("--no-open", action="store_true",
                   help="do not open the result in a browser")
    p.add_argument("--json", action="store_true",
                   help="print per-day counts as JSON and exit; no HTML")

    scope = p.add_argument_group("commit selection")
    scope.add_argument("--author", action="append", metavar="PATTERN",
                       help="only commits by this author (repeatable; git regex)")
    scope.add_argument("--branch", default="HEAD", metavar="REF",
                       help="ref to walk (default: HEAD)")
    scope.add_argument("--all", dest="all_refs", action="store_true",
                       help="walk every ref instead of just --branch")
    scope.add_argument("--no-merges", action="store_true",
                       help="exclude merge commits")
    scope.add_argument("--since", metavar="DATE", help="passed through to git log")
    scope.add_argument("--until", metavar="DATE", help="passed through to git log")
    scope.add_argument("--date", choices=("author", "committer"), default="author",
                       help="bucket by author or committer date (default: author)")
    scope.add_argument("--path", nargs="+", metavar="PATHSPEC",
                       help="limit to commits touching these paths")

    pres = p.add_argument_group("presentation")
    pres.add_argument("--title", help="page title (default: derived from the repo)")
    pres.add_argument("--label", help="repo label shown on the page")

    p.add_argument("-v", "--verbose", action="store_true", help="debug logging")
    p.add_argument("--version", action="version", version=f"git-heatmap {__version__}")
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    logging.basicConfig(
        level=logging.DEBUG if args.verbose else logging.INFO,
        format="%(levelname)s: %(message)s",
        stream=sys.stderr,
    )

    try:
        repo = resolve_repo(args.repo.expanduser().resolve())
        counts = collect_counts(repo, args)

        if not counts:
            log.error("no commits matched in %s", repo)
            return 2

        if args.json:
            json.dump(dict(sorted(counts.items())), sys.stdout, indent=2)
            sys.stdout.write("\n")
            return 0

        meta = build_meta(repo, args, counts)
        html = render_html(counts, meta)

        if args.output:
            out = args.output.expanduser().resolve()
            out.parent.mkdir(parents=True, exist_ok=True)
        else:
            slug = meta["repo"].replace("/", "-")
            out = Path(tempfile.gettempdir()) / f"{slug}-commit-frequency.html"
        out.write_text(html, encoding="utf-8")

        total, active = sum(counts.values()), len(counts)
        log.info(
            "%s commit%s across %s day%s → %s",
            f"{total:,}", "" if total == 1 else "s",
            f"{active:,}", "" if active == 1 else "s", out,
        )

        if not args.no_open:
            webbrowser.open(out.as_uri())
        return 0

    except GitHeatmapError as exc:
        log.error("%s", exc)
        return 1
    except KeyboardInterrupt:
        return 130


